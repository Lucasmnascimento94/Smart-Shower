
	SerialPrint("\nFinal Position for each Canvas\n");
	if(canvas->settings!=NULL){
		SerialPrint("Container -> ");
		SerialPrint(canvas->settings->Canvas_ID);
		SerialPrint(" -> ");
		static char num[40];
		sprintf(num, "x-> %d | y-> %d\n", (int)canvas->settings->canvasStart_x, (int)canvas->settings->canvasStart_y);
		SerialPrint(num);
		SerialPrint("\n");
	}

	if(canvas->text!=NULL){
		SerialPrint("Text -> ");
		SerialPrint(canvas->text->Text_ID);
		SerialPrint(" -> ");
		static char num[40];
		sprintf(num, "x-> %d | y-> %d\n", (int)canvas->text->offset_right, (int)canvas->text->offset_top);
		SerialPrint(num);
		SerialPrint("\n");
	}

























